FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    libssl-dev \
    python3-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --------------------------------------------------------
# Install liboqs (Official Production Installation)
# --------------------------------------------------------
RUN git clone --depth 1 --branch main https://github.com/open-quantum-safe/liboqs.git /tmp/liboqs && \
    cd /tmp/liboqs && \
    mkdir build && \
    cd build && \
    cmake -GNinja -DBUILD_SHARED_LIBS=ON .. && \
    ninja -j1 && \
    ninja install && \
    ldconfig && \
    rm -rf /tmp/liboqs

# --------------------------------------------------------
# Install liboqs-python
# --------------------------------------------------------
RUN git clone --depth 1 --branch main https://github.com/open-quantum-safe/liboqs-python.git /tmp/liboqs-python && \
    cd /tmp/liboqs-python && \
    pip install . && \
    rm -rf /tmp/liboqs-python

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "edge_server:app", "--host", "0.0.0.0", "--port", "8000"]